# Copy this file to .env and fill in your own values. .env is git-ignored.

# SQLite database file (relative to backend/).
DATABASE_URL=sqlite:///./todos.db

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Set to true when the app is served over HTTPS, so the session cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# AI features (Smart Add, Break it down). Leave empty to run without AI.
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
