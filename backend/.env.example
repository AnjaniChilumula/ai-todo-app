# Copy this file to .env and fill in your own values. .env is git-ignored.

# SQLite database file (relative to backend/).
DATABASE_URL=sqlite:///./todos.db

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Set to true when the app is served over HTTPS, so the session cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# Where people open the app (the Vite dev server). Google redirects back via this address.
APP_URL=http://localhost:5173

# Signs the short-lived cookie used during Google sign-in. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Sign in with Google (optional). Create an OAuth client of type "Web application" in Google Cloud
# Console with this authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features (Smart Add, Break it down). Leave empty to run without AI.
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
